{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "php -S 0.0.0.0:8080 -t public public/router.php",
    "preDeployCommand": "php artisan config:clear && php artisan migrate --force"
  }
}
